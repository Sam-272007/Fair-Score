{
  "name": "fairscore",
  "version": "1.0.0",
  "description": "FairScore - Bias-corrected judging and ranking for hackathons and competitions",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "test": "npm --prefix client run test && npm --prefix server test",
    "test:client": "npm --prefix client run test",
    "test:server": "npm --prefix server test",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
